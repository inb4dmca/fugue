macro "macro"
	elem
		name = "F2"
		command = "report"

window "main"
	elem "main"
		type = MAIN
		pos = 0,0
		size = 480x600
		anchor1 = none
		anchor2 = none
		background-color = #ff007f
		is-visible = true
		is-default = true
		saved-params = ""
		title = "hudstack"
		titlebar = true
		statusbar = false
		can-close = true
		can-minimize = true
		can-resize = true
		is-pane = false
		is-maximized = false
		macro = "macro"
		menu = ""
	elem "map"
		type = MAP
		pos = 0,0
		size = 480x480
		anchor1 = none
		anchor2 = none
		background-color = #000000
		is-visible = true
		is-default = true
		saved-params = ""
		icon-size = 32
		letterbox = true
		zoom-mode = normal
		text-mode = false
	elem "out"
		type = OUTPUT
		pos = 0,480
		size = 480x120
		anchor1 = none
		anchor2 = none
		is-visible = true
		is-default = true
		saved-params = ""
