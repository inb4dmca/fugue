// Scene for tests/atomname_test.cpp. scene.dmi is the menuicons-world sheet (tests/data/menuicons-world/res/1980f8b1); copy it
// next to this file as scene.dmi to compile.

// Names carry BYOND text-macro markers, as vg writes them.
world
	name = "atomname"
	view = 7
	icon_size = 32
	mob = /mob/player
	turf = /turf/space
	maxx = 15
	maxy = 15
	maxz = 1

turf/space
	name = "\proper space"            // vg's space turf: "\xff\x15space" on the wire
	icon = 'scene.dmi'
	icon_state = "floor"

obj/pipe
	name = "\improper Scrubbers pipe" // vg's scrubbers manifold pipe
	icon = 'scene.dmi'
	icon_state = "solid"

mob/player
	icon = null
	Login()
		loc = locate(8, 8, 1)
		..()

world/New()
	..()
	new /obj/pipe(locate(8, 8, 1))
