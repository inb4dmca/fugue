* text=auto eol=lf
# Captures/resources are byte-exact, including resources that happen to contain text.
tests/data/** -text
# Captured text can retain CRLF; do not flag its CR as trailing whitespace.
tests/data/**/*.txt whitespace=cr-at-eol
# Shadow replay resources retain their original bytes, including the DMF skin.
tests/data/stock-shadow-world/res/* binary
*.png -text
*.gif -text
*.jpg -text
*.dmi -text
*.ico -text
