# macdeployqt can emit @executable_path references in shared frameworks. Those work in the main app but not when
# the same framework is loaded by the deeply nested WebEngineProcess. Make every bundled dependency loader-relative,
# and reject missing/non-system external dependencies before signing. Dylib install IDs are not dependencies.
file(GLOB_RECURSE binaries LIST_DIRECTORIES FALSE "${bundle}/Contents/*")
foreach(binary IN LISTS binaries)
  if(IS_SYMLINK "${binary}")
    continue()
  endif()
  file(READ "${binary}" magic LIMIT 4 HEX)
  if(NOT magic MATCHES "^(cffaedfe|cefaedfe|feedfacf|feedface|cafebabe|bebafeca|cafebabf|bfbafeca)$")
    continue()
  endif()
  execute_process(COMMAND /usr/bin/otool -D "${binary}" OUTPUT_VARIABLE ids COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND /usr/bin/otool -L "${binary}" OUTPUT_VARIABLE deps COMMAND_ERROR_IS_FATAL ANY)
  string(REGEX MATCHALL "\n\t[^\n]+" deps "${deps}")
  get_filename_component(directory "${binary}" DIRECTORY)
  set(changes)
  foreach(line IN LISTS deps)
    string(REGEX REPLACE "^\n\t(.*) \\(compatibility version.*$" "\\1" dep "${line}")
    string(FIND "${ids}" "\n${dep}\n" is_id)
    if(NOT is_id EQUAL -1 OR dep MATCHES "^(/System/Library/|/usr/lib/)")
      continue()
    endif()
    if(dep MATCHES "^@executable_path/(.*)$")
      set(target "${bundle}/Contents/MacOS/${CMAKE_MATCH_1}")
    elseif(dep MATCHES "^@loader_path/(.*)$")
      set(target "${directory}/${CMAKE_MATCH_1}")
    elseif(dep MATCHES "^@rpath/(.*)$")
      set(target "${bundle}/Contents/Frameworks/${CMAKE_MATCH_1}")
    else()
      message(FATAL_ERROR "External dependency in ${binary}: ${dep}")
    endif()
    if(NOT EXISTS "${target}")
      message(FATAL_ERROR "Missing bundled dependency in ${binary}: ${dep} (${target})")
    endif()
    get_filename_component(target "${target}" REALPATH)
    file(RELATIVE_PATH in_bundle "${bundle}" "${target}")
    if(in_bundle MATCHES "^\\.\\./" OR IS_ABSOLUTE "${in_bundle}")
      message(FATAL_ERROR "Dependency escapes the bundle in ${binary}: ${dep}")
    endif()
    file(RELATIVE_PATH relative "${directory}" "${target}")
    list(APPEND changes -change "${dep}" "@loader_path/${relative}")
  endforeach()
  if(changes)
    execute_process(COMMAND /usr/bin/install_name_tool ${changes} "${binary}" COMMAND_ERROR_IS_FATAL ANY)
  endif()
endforeach()
