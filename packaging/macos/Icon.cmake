# Convert the existing artwork with tools supplied by macOS; no Python/image library dependency.
set(iconset "${OUTPUT_DIR}/Fugue.iconset")
file(MAKE_DIRECTORY "${iconset}")
foreach(size 16 32 128 256 512)
  foreach(scale 1 2)
    math(EXPR pixels "${size} * ${scale}")
    if(scale EQUAL 1)
      set(name "icon_${size}x${size}.png")
    else()
      set(name "icon_${size}x${size}@2x.png")
    endif()
    set(source "${SOURCE_DIR}/io.github.toomykins.Fugue-${pixels}.png")
    if(EXISTS "${source}")
      configure_file("${source}" "${iconset}/${name}" COPYONLY)
    else()
      execute_process(COMMAND /usr/bin/sips -z ${pixels} ${pixels}
        "${SOURCE_DIR}/io.github.toomykins.Fugue-256.png" --out "${iconset}/${name}"
        RESULT_VARIABLE result OUTPUT_QUIET)
      if(NOT result EQUAL 0)
        message(FATAL_ERROR "sips failed: ${result}")
      endif()
    endif()
  endforeach()
endforeach()
execute_process(COMMAND /usr/bin/iconutil -c icns "${iconset}" -o "${OUTPUT_DIR}/Fugue.icns"
  RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "iconutil failed: ${result}")
endif()
